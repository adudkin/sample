# Public DNS hostname, without https://, port or path.
DOMAIN=vsevmeste.tech
# Choose a unique password before the first database initialization.
POSTGRES_PASSWORD=change-me-before-start
# Mount the whole directory: live/ contains links into archive/.
TLS_DIRECTORY=/etc/letsencrypt
# Host directory Certbot writes HTTP-01 validation files into.
# Create it before starting Compose. Mounted read-only inside nginx.
ACME_WEBROOT=./certbot-www
